# ==========================================================
# INFOSYS - FULL REGRESSION + RISK REGIME PIPELINE
# ==========================================================



import yfinance as yf
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score


# ==========================================================
# 1. DOWNLOAD WEEKLY DATA
# ==========================================================

ticker = "INFY.NS"

df = yf.download(ticker, start="2010-01-01", interval="1wk", auto_adjust=True)
df = df.dropna().reset_index()

print("Downloaded shape:", df.shape)


# ==========================================================
# 2. FEATURE ENGINEERING
# ==========================================================

# EMAs
df["ema_20"] = df["Close"].ewm(span=20).mean()
df["ema_50"] = df["Close"].ewm(span=50).mean()
df["ema_100"] = df["Close"].ewm(span=100).mean()

# RSI
delta = df["Close"].diff()
gain = delta.clip(lower=0)
loss = -delta.clip(upper=0)
avg_gain = gain.rolling(14).mean()
avg_loss = loss.rolling(14).mean()
rs = avg_gain / avg_loss
df["rsi_14"] = 100 - (100 / (1 + rs))
df["rsi_change"] = df["rsi_14"].diff()

# MACD
ema12 = df["Close"].ewm(span=12).mean()
ema26 = df["Close"].ewm(span=26).mean()
df["macd"] = ema12 - ema26
df["macd_signal"] = df["macd"].ewm(span=9).mean()
df["macd_hist"] = df["macd"] - df["macd_signal"]

# Bollinger Bands
rolling_mean = df["Close"].rolling(20).mean()
rolling_std = df["Close"].rolling(20).std()
df["bb_percent"] = (df["Close"] - rolling_mean) / (2 * rolling_std)
df["bb_width"] = (2 * rolling_std) / rolling_mean

# OBV
df["obv"] = (np.sign(df["Close"].diff()) * df["Volume"]).fillna(0).cumsum()
df["obv_slope"] = df["obv"].diff()

# ADX
df["tr1"] = df["High"] - df["Low"]
df["tr2"] = abs(df["High"] - df["Close"].shift())
df["tr3"] = abs(df["Low"] - df["Close"].shift())

df["tr"] = df[["tr1", "tr2", "tr3"]].max(axis=1)
df["atr"] = df["tr"].rolling(14).mean()

df["up_move"] = df["High"].diff()
df["down_move"] = -df["Low"].diff()

df["plus_dm"] = np.where(
    (df["up_move"] > df["down_move"]) & (df["up_move"] > 0),
    df["up_move"],
    0
)

df["minus_dm"] = np.where(
    (df["down_move"] > df["up_move"]) & (df["down_move"] > 0),
    df["down_move"],
    0
)

df["plus_di"] = 100 * (pd.Series(df["plus_dm"]).rolling(14).sum() / df["atr"])
df["minus_di"] = 100 * (pd.Series(df["minus_dm"]).rolling(14).sum() / df["atr"])

df["dx"] = 100 * abs(df["plus_di"] - df["minus_di"]) / (df["plus_di"] + df["minus_di"])
df["adx"] = df["dx"].rolling(14).mean()

df = df.dropna()


# ==========================================================
# 3. TARGET
# ==========================================================

df["future_4w_return"] = df["Close"].shift(-4) / df["Close"] - 1
df = df.dropna()


# ==========================================================
# 4. TRAIN / TEST SPLIT
# ==========================================================

feature_cols = [
    "ema_20", "ema_50", "ema_100",
    "rsi_14", "rsi_change",
    "macd", "macd_signal", "macd_hist",
    "bb_percent", "bb_width",
    "obv", "obv_slope",
    "adx", "plus_di", "minus_di"
]

X = df[feature_cols]
y = df["future_4w_return"]

split = int(len(df) * 0.8)

X_train = X.iloc[:split]
X_test = X.iloc[split:]
y_train = y.iloc[:split]
y_test = y.iloc[split:]

test_df = df.iloc[split:].copy()


# ==========================================================
# 5. TRAIN MODEL
# ==========================================================

model = RandomForestRegressor(
    n_estimators=400,
    max_depth=6,
    min_samples_leaf=5,
    random_state=42,
    n_jobs=-1
)

model.fit(X_train, y_train)
y_pred = model.predict(X_test)


# ==========================================================
# 6. METRICS
# ==========================================================

print("\n=== REGRESSION PERFORMANCE ===")
print("MAE:", mean_absolute_error(y_test, y_pred))
print("RMSE:", np.sqrt(mean_squared_error(y_test, y_pred)))
print("R²:", r2_score(y_test, y_pred))


# ==========================================================
# 7. RISK REGIME (30% filter)
# ==========================================================

threshold = np.quantile(y_pred, 0.3)

test_df["predicted_return"] = y_pred
test_df["risk_flag"] = test_df["predicted_return"] < threshold

test_df["buy_hold_return"] = y_test.values
test_df["strategy_return"] = np.where(
    test_df["risk_flag"],
    0,
    y_test.values
)

test_df["buy_hold_equity"] = (1 + test_df["buy_hold_return"]).cumprod()
test_df["strategy_equity"] = (1 + test_df["strategy_return"]).cumprod()


# ==========================================================
# 8. PERFORMANCE
# ==========================================================

def max_drawdown(series):
    peak = series.cummax()
    dd = (series - peak) / peak
    return dd.min()

def sharpe_ratio(returns):
    return np.sqrt(52) * returns.mean() / returns.std()

print("\n=== STRATEGY PERFORMANCE ===")
print("Buy & Hold Final:", test_df["buy_hold_equity"].iloc[-1])
print("Strategy Final:", test_df["strategy_equity"].iloc[-1])
print("Buy & Hold MaxDD:", max_drawdown(test_df["buy_hold_equity"]))
print("Strategy MaxDD:", max_drawdown(test_df["strategy_equity"]))
print("Buy & Hold Sharpe:", sharpe_ratio(test_df["buy_hold_return"]))
print("Strategy Sharpe:", sharpe_ratio(test_df["strategy_return"]))


# ==========================================================
# 9. GRAPH
# ==========================================================

plt.figure(figsize=(12,6))
plt.plot(test_df["Date"], test_df["buy_hold_equity"])
plt.plot(test_df["Date"], test_df["strategy_equity"])
plt.title("Infosys - Buy & Hold vs Risk Regime")
plt.xlabel("Date")
plt.ylabel("Equity")
plt.legend(["Buy & Hold", "Risk Regime"])
plt.grid(True)
plt.show()
